# Borsalıyorum v2 ortam değişkenleri. Kopyala: `cp .env.example .env.local` (gitignore'da).
# Adlar v1 ile aynıdır; Vercel projesinde zaten tanımlıdır. Şema: src/lib/env.ts
# `next build` bu değişkenler eksik/geçersizse durur. Secrets'sız CI build'i için
# SKIP_ENV_VALIDATION=1 kullanılır; Vercel'de (VERCEL=1) bu bayrak yok sayılır.

# --- Sunucu (asla NEXT_PUBLIC_ önekiyle ya da next.config `env` ile istemciye verilmez) ---
# Runtime: Neon **pooled** URL (src/lib/db).
DATABASE_URL="postgresql://user:password@localhost:5432/borsaliyorum"
# Yalnızca Prisma CLI (migrate/diff): doğrudan, pooler olmayan URL. Vercel–Neon entegrasyonu
# bu adla verir. Boşsa CLI DATABASE_URL'i kullanır (prisma.config.ts).
# DATABASE_URL_UNPOOLED=""
# `prisma migrate diff --from-migrations` gibi komutlar için boş bir shadow DB (opsiyonel)
# SHADOW_DATABASE_URL=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Tek satır, satır sonları \n olarak: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=""
# ContentEvent IP şifreleme anahtarı (AES-256-GCM, base64 kodlu 32 bayt; legal L2).
# Production runtime'da (Vercel production + preview) ZORUNLU; build ve testler onsuz çalışır.
# Üret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Kaybolursa kayıtlı IP'ler çözülemez: bir parola kasasında yedekle, ortamlar arasında paylaşma.
IP_ENCRYPTION_KEY=""
# Opsiyonel: POST /api/revalidate/stocks paylaşılan secret'ı (en az 32 karakter). GitHub
# Actions'ta aynı değer `STOCKS_REVALIDATE_SECRET` secret'ı, site adresi `SITE_URL` değişkeni.
# Tanımsızsa uç 404 döner; hisse indeksi 24 saatte bir kendiliğinden tazelenir.
STOCKS_REVALIDATE_SECRET=""

# --- İstemci (build'e gömülür, gizli değildir) ---
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_MESSAGE_SENDER_ID=""
NEXT_PUBLIC_APP_ID=""
# Opsiyonel (v2'de analitik yok)
NEXT_PUBLIC_MEASUREMENT_ID=""
# Opsiyonel: sitenin kök URL'si; bu host'a giden linkler önizlenmez (iç link)
NEXT_PUBLIC_SITE_URL="https://borsaliyorum.com"

# --- Opsiyonel ---
# LOG_LEVEL=info            # debug | info | warn | error | silent
# Onboarding'deki pazarlama izni kutusu (6563/İYS). Varsayılan KAPALI; yalnızca "true" açar.
# İYS yüklemesi (3 iş günü) ve ret akışı hazır olmadan açılmaz (docs/legal/auth-metinleri.md).
# MARKETING_CONSENT_ENABLED=false
# Yalnızca scripts/purge-retention.ts: Firebase yetim hesaplarını gerçekten silmek için
# `--execute` İLE BİRLİKTE "true" olmalı; yoksa Firebase adımı yalnızca sayar (README "Bakım işleri").
# ORPHAN_PURGE_ENABLED=false
# YALNIZCA TEST: safeFetch'in SSRF politikası dışında tutacağı IP'ler (yerel test sunucusu).
# Build sırasında ya da NODE_ENV=production iken tanımlıysa uygulama hata verir.
# SAFE_FETCH_TEST_ALLOW=127.0.0.1
# SKIP_ENV_VALIDATION=1     # yalnızca CI/yerel build; Vercel'de etkisiz
# ENABLE_DEV_PAGES=1        # /dev/* önizleme sayfaları prod build'de (yalnızca E2E); Vercel production'da etkisiz

# --- Yalnızca yerel testler: .env.test.local dosyasına yaz (gitignore'da) ---
# Önceden kurulu Chromium yolu (ADR-0003). Boşsa Playwright kendi tarayıcısını kullanır.
# PW_CHROMIUM_EXECUTABLE=/opt/pw-browsers/chromium
# Integration testleri ve db:migrations:check için yerel Postgres (`npm run db:test:up`).
# Yalnızca localhost kabul edilir; testler asla Neon'a bağlanmaz.
# TEST_DATABASE_URL=postgresql://postgres:test@localhost:54329/postgres
# E2E portları/DB (paralel worktree koşuları için; varsayılan 3100 / 9099 / borsaliyorum_e2e)
# E2E_PORT=3100
# E2E_AUTH_EMULATOR_PORT=9099
# E2E_DATABASE=borsaliyorum_e2e
# Firebase Auth emulator değişkenleri (FIREBASE_AUTH_EMULATOR_HOST,
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST) yalnızca E2E build'inde set edilir
# (tests/e2e/support/env.ts). VERCEL_ENV=production iken set ise build ve sunucu başlamaz.
