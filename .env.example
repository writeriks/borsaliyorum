# Borsalıyorum v2 ortam değişkenleri. Kopyala: `cp .env.example .env.local` (gitignore'da).
# Adlar v1 ile aynıdır; Vercel projesinde zaten tanımlıdır. Şema: src/lib/env.ts
# `next build` bu değişkenler eksik/geçersizse durur. Secrets'sız CI build'i için
# SKIP_ENV_VALIDATION=1 kullanılır; Vercel'de (VERCEL=1) bu bayrak yok sayılır.

# --- Sunucu (asla NEXT_PUBLIC_ önekiyle ya da next.config `env` ile istemciye verilmez) ---
DATABASE_URL="postgresql://user:password@localhost:5432/borsaliyorum"
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Tek satır, satır sonları \n olarak: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=""

# --- İstemci (build'e gömülür, gizli değildir) ---
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_MESSAGE_SENDER_ID=""
NEXT_PUBLIC_APP_ID=""
# Opsiyonel (v2'de analitik yok)
NEXT_PUBLIC_MEASUREMENT_ID=""

# --- Opsiyonel ---
# LOG_LEVEL=info            # debug | info | warn | error | silent
# SKIP_ENV_VALIDATION=1     # yalnızca CI/yerel build; Vercel'de etkisiz

# --- Yalnızca yerel testler: .env.test.local dosyasına yaz (gitignore'da) ---
# Önceden kurulu Chromium yolu (ADR-0003). Boşsa Playwright kendi tarayıcısını kullanır.
# PW_CHROMIUM_EXECUTABLE=/opt/pw-browsers/chromium
