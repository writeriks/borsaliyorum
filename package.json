{
  "name": "borsaliyorum",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project dom --project integration",
    "test:unit": "vitest run --project unit --project dom",
    "test:browser": "vitest run --project browser --passWithNoTests",
    "test:e2e": "playwright test",
    "build:e2e": "SKIP_ENV_VALIDATION=1 next build",
    "start:e2e": "next start -p 3100"
  },
  "dependencies": {
    "next": "~16.4.0",
    "next-intl": "~4.14.9",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "server-only": "~0.0.1",
    "zod": "~4.6.5"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "~4.8.1",
    "@eslint/js": "~9.39.5",
    "@playwright/test": "~1.64.0",
    "@prisma/client": "~5.19.0",
    "@tailwindcss/postcss": "~4.3.3",
    "@testing-library/dom": "~10.4.2",
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "~16.3.3",
    "@testing-library/user-event": "~14.6.7",
    "@types/node": "~22.20.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~6.1.2",
    "@vitest/browser-playwright": "~5.0.3",
    "@vitest/coverage-v8": "~5.0.3",
    "eslint": "~9.39.5",
    "eslint-config-next": "~16.4.0",
    "eslint-config-prettier": "~10.1.8",
    "fast-check": "~4.10.2",
    "globals": "~17.13.0",
    "jsdom": "~30.1.2",
    "playwright": "~1.64.0",
    "prettier": "~3.9.10",
    "prettier-plugin-tailwindcss": "~0.8.1",
    "prisma": "~5.19.0",
    "tailwindcss": "~4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.1",
    "vite": "~8.3.4",
    "vitest": "~5.0.3"
  }
}
