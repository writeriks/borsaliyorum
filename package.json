{
  "name": "borsaliyorum",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project dom --project integration",
    "test:unit": "vitest run --project unit --project dom",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:browser": "vitest run --project browser --passWithNoTests",
    "test:e2e": "playwright test",
    "build:e2e": "SKIP_ENV_VALIDATION=1 next build",
    "start:e2e": "ENABLE_DEV_PAGES=1 next start -p ${E2E_PORT:-3100}",
    "emulators": "node scripts/e2e-emulator.mjs",
    "db:test:up": "scripts/pg-local.sh start",
    "db:test:down": "scripts/pg-local.sh stop",
    "db:migrations:check": "tsx scripts/check-migrations.ts",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "~5.9.1",
    "@prisma/adapter-pg": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "@vercel/functions": "~3.9.11",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "firebase": "~13.0.0",
    "firebase-admin": "~14.5.0",
    "htmlparser2": "~12.0.0",
    "ipaddr.js": "~2.5.0",
    "lucide-react": "~1.55.0",
    "next": "~16.4.0",
    "next-intl": "~4.14.9",
    "next-themes": "~0.4.6",
    "pg": "~8.23.1",
    "pg-connection-string": "~2.14.1",
    "radix-ui": "~1.7.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-hook-form": "~7.89.0",
    "server-only": "~0.0.1",
    "sonner": "~2.0.8",
    "tailwind-merge": "~3.7.0",
    "tldts": "~7.4.18",
    "undici": "~8.11.2",
    "zod": "~4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.13.0",
    "@eslint-community/eslint-plugin-eslint-comments": "~4.8.1",
    "@eslint/js": "~9.39.5",
    "@playwright/test": "~1.64.0",
    "@tailwindcss/postcss": "~4.3.3",
    "@testing-library/dom": "~10.4.2",
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "~16.3.3",
    "@testing-library/user-event": "~14.6.7",
    "@types/node": "~22.20.5",
    "@types/pg": "~8.23.1",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~6.1.2",
    "@vitest/browser-playwright": "~5.0.3",
    "@vitest/coverage-v8": "~5.0.3",
    "eslint": "~9.39.5",
    "eslint-config-next": "~16.4.0",
    "eslint-config-prettier": "~10.1.8",
    "fast-check": "~4.10.2",
    "globals": "~17.13.0",
    "jsdom": "~30.1.2",
    "playwright": "~1.64.0",
    "prettier": "~3.9.10",
    "prettier-plugin-tailwindcss": "~0.8.1",
    "prisma": "~7.10.0",
    "tailwindcss": "~4.3.3",
    "tsx": "~4.23.15",
    "tw-animate-css": "~1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.1",
    "vite": "~8.3.4",
    "vitest": "~5.0.3"
  }
}
